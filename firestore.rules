rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlistApplications/{userId} {
      function isYouthSailingUser() {
        return request.auth != null
          && request.auth.token.firebase.tenant == "sailing-trip-lk5r5"
          && request.auth.uid == userId;
      }

      function hasValidApplicationShape() {
        return request.resource.data.keys().hasOnly([
            "name",
            "email",
            "phone",
            "role",
            "note",
            "status",
            "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "name",
            "email",
            "phone",
            "role",
            "note",
            "status",
            "createdAt"
          ])
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.phone is string
          && request.resource.data.role is string
          && request.resource.data.note is string
          && request.resource.data.status == "waitlisted"
          && request.resource.data.createdAt is timestamp;
      }

      allow create: if isYouthSailingUser()
        && hasValidApplicationShape()
        && request.resource.data.email == request.auth.token.email;

      allow get: if isYouthSailingUser();

      allow update, delete: if false;
    }
  }
}
